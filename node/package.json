{
  "name": "orrery-node",
  "version": "0.1.9",
  "description": "Peer-to-peer AI inference on Solana. An OpenAI-compatible router on localhost that sends every request straight to a provider's machine and pays it per answer through a payment channel. Zero cut in between.",
  "license": "MIT",
  "keywords": [
    "solana",
    "ai",
    "llm",
    "inference",
    "p2p",
    "peer-to-peer",
    "openai",
    "openai-compatible",
    "router",
    "gateway",
    "payment-channel",
    "micropayments",
    "usdc",
    "decentralized",
    "vllm",
    "ollama",
    "gpu",
    "cursor",
    "langchain"
  ],
  "homepage": "https://orrerynode.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orrery-node/orrery.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/orrery-node/orrery/issues"
  },
  "type": "module",
  "bin": {
    "orrery": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "orrery": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx devtools/e2e.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "author": "Orrery (https://orrerynode.com)"
}
