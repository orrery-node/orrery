{
  "name": "orrery-node",
  "version": "0.1.0",
  "private": true,
  "description": "Orrery router and provider node: point your AI tools at localhost, pay providers directly on Solana",
  "type": "module",
  "bin": {
    "orrery": "./src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "orrery": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "bash devtools/e2e.sh"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
