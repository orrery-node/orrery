{
  "name": "orrery-node",
  "version": "0.1.0",
  "description": "Orrery router and provider node: point your AI tools at localhost, pay providers directly on Solana. Peer to peer, zero cut in between.",
  "license": "MIT",
  "keywords": [
    "solana",
    "ai",
    "inference",
    "p2p",
    "openai-compatible",
    "router",
    "llm",
    "payment-channel"
  ],
  "homepage": "https://orrerynode.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orrery-node/orrery.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/orrery-node/orrery/issues"
  },
  "type": "module",
  "bin": {
    "orrery": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "orrery": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "bash devtools/e2e.sh",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
